<Window x:Class="Unison_Almacen_App.Views.NotaInicioView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Unison_Almacen_App.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="NotasInicio" Height="450" Width="800">
    <Grid>
          
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Image Grid.Row="0" 
               Height="130" 
               Source="../Resources/Logo_Unison.png" 
               Margin="0 80 0 20"/>
        
        <ui:TextBlock Grid.Row="1" 
                      Text="Notas"
                      Style="{StaticResource TitleText}"/>
        
        <TextBlock Grid.Row="2" 
                   Text="Notitas bien UwU"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <Button Grid.Row="3"
                Content="Agregar Nota"
                Width="150"
                Height="40"
                Background="LightBlue"
                Foreground="Black"
                FontSize="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20"
                Click="OnIrALaListaDeNotasClick"/>
        <TextBlock Grid.Row="3" 
                   Text="Edgar Rafael Romero Martin"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"/>
    </Grid>
</Window>
