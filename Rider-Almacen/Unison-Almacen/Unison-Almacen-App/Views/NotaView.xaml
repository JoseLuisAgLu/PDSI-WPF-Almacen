<Window x:Class="UnisonAlmacen.App.Views.NotaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Nota" Height="400" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Título:" FontWeight="Bold" />
            <TextBox Text="{Binding Titulo}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Contenido:" FontWeight="Bold" />
            <TextBox Text="{Binding Contenido}" AcceptsReturn="True" Height="200" />
        </StackPanel>

        <Button Content="Guardar Nota" Grid.Row="2" Height="40" 
                HorizontalAlignment="Center" Command="{Binding GuardarNotaCommand}" />
    </Grid>
</Window>
